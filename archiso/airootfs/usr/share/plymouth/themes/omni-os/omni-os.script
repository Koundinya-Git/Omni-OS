# Plymouth script for Omni-OS

# Dark glassmorphic, Tokyo Night inspired bg
Window.SetBackgroundTopColor(0.10196, 0.10588, 0.14902);    # #1a1b26
Window.SetBackgroundBottomColor(0.10196, 0.10588, 0.14902); # #1a1b26

# Center Omni-OS Text
logo.image = Image.Text("OMNI-OS", 1.0, 1.0, 1.0, 1.0, "Sans 36");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

# Elegant loading spinner (cyan #7dcfff)
spinner.image = Image.Text("|", 0.4902, 0.81176, 1.0, 1.0, "Sans 24");
spinner.sprite = Sprite(spinner.image);
spinner.sprite.SetX(Window.GetWidth() / 2 - spinner.image.GetWidth() / 2);
spinner.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() + 30);

spinner_angle = 0;
fun refresh_callback () {
    spinner_angle += 0.1;
    spinner.sprite.SetImage(spinner.image.Rotate(spinner_angle));
}
Plymouth.SetRefreshFunction(refresh_callback);

# Boot messages
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2, Window.GetHeight() / 2 + 100, 10000);

fun display_message_callback (text) {
    my_image = Image.Text(text, 1.0, 1.0, 1.0, 1.0, "Sans 12");
    message_sprite.SetImage(my_image);
    message_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetUpdateStatusFunction(display_message_callback);

# LUKS / Password Prompt
password_prompt_sprite = Sprite();
password_prompt_sprite.SetPosition(Window.GetWidth() / 2, Window.GetHeight() / 2 + 140, 10000);

fun display_password_callback (prompt, bullets) {
    bullet_string = "";
    for (i = 0; i < bullets; i++) {
        bullet_string += "•";
    }
    text = prompt + " " + bullet_string;
    # Magenta accent #bb9af7
    my_image = Image.Text(text, 0.7333, 0.6039, 0.9686, 1.0, "Sans 12"); 
    password_prompt_sprite.SetImage(my_image);
    password_prompt_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    password_prompt_sprite.SetImage(Image());
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Progress Callback
fun boot_progress_callback (duration, progress) {
    # Could expand with a progress bar, but minimal spinner is requested
}
Plymouth.SetBootProgressFunction(boot_progress_callback);
