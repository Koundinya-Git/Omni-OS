# Plymouth script for Omni-OS

# Deep Black Background
Window.SetBackgroundTopColor(0.02, 0.02, 0.02);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.02);

# Omni-OS Uploaded Glowing Logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetZ(100);

# Rocket Streaks
streak_image = Image.Text("|", 0.0, 0.898, 1.0, 0.8, "Sans 40");
NUM_STREAKS = 20;

i = 0;
while (i < NUM_STREAKS) {
    streaks[i].sprite = Sprite(streak_image);
    streaks[i].x = Math.Random() * Window.GetWidth();
    streaks[i].y = Math.Random() * Window.GetHeight();
    streaks[i].speed = 5 + (Math.Random() * 10);
    streaks[i].sprite.SetX(streaks[i].x);
    streaks[i].sprite.SetY(streaks[i].y);
    streaks[i].sprite.SetZ(1);
    i++;
}

fun refresh_callback () {
    i = 0;
    while (i < NUM_STREAKS) {
        streaks[i].y += streaks[i].speed;
        if (streaks[i].y > Window.GetHeight()) {
            streaks[i].y = -100;
            streaks[i].x = Math.Random() * Window.GetWidth();
            streaks[i].speed = 5 + (Math.Random() * 10);
        }
        streaks[i].sprite.SetY(streaks[i].y);
        streaks[i].sprite.SetX(streaks[i].x);
        i++;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

# Hide default boot messages for clean cinematic look
fun display_message_callback (text) {
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetUpdateStatusFunction(display_message_callback);

# LUKS / Disk Encryption Password Prompt
password_prompt_sprite = Sprite();
password_prompt_sprite.SetPosition(Window.GetWidth() / 2, Window.GetHeight() / 2 + 140, 200);

fun display_password_callback (prompt, bullets) {
    bullet_string = "";
    b = 0;
    while (b < bullets) {
        bullet_string += "●";
        b++;
    }
    text = prompt + " " + bullet_string;
    my_image = Image.Text(text, 0.0, 0.898, 1.0, 1.0, "Sans 16");
    password_prompt_sprite.SetImage(my_image);
    password_prompt_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    password_prompt_sprite.SetImage(Image());
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

