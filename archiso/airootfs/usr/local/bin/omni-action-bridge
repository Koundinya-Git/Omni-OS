#!/usr/bin/env bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
p=$(kitty --class scratchpad -e bash -c 'read -rp "Omni Action> " cmd; echo "$cmd"')
[ -z "$p" ] && exit 0

mkdir -p ~/.config/eww
sys="Translate the following natural language request into an eww configuration. Output ONLY the yuck file wrapped in \`\`\`yuck ... \`\`\` blocks, and the css file wrapped in \`\`\`css ... \`\`\` blocks. Define a main window named 'omni-widget'."
res=$(curl -s -X POST http://localhost:11434/api/generate -d "{\"model\": \"llama3.2:1b\", \"prompt\": \"$sys\nUser Request: $p\", \"stream\": false}" | jq -r '.response')

yuck=$(echo "$res" | awk '/^```yuck/{f=1; next} /^```/{f=0} f')
css=$(echo "$res" | awk '/^```css/{f=1; next} /^```/{f=0} f')

if [ -n "$yuck" ]; then
    echo "$yuck" > ~/.config/eww/eww.yuck
    echo "$css" > ~/.config/eww/eww.scss
    
    # Reload eww and open the dynamically generated widget
    eww reload || true
    eww open omni-widget
fi
