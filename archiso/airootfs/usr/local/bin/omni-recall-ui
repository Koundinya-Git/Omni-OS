#!/usr/bin/env bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
q=$(rofi -dmenu -p "Semantic Recall" -theme-str 'window {width: 40%;} listview {lines: 0;}')
[ -z "$q" ] && exit 0
notify-send "Omni-Recall" "Searching memory for: $q"
res=$(omni-recall-search "$q")
if echo "$res" | jq -e '.match == true' >/dev/null; then
    img=$(echo "$res" | jq -r '.path')
    if [ -f "$img" ]; then
        notify-send "Omni-Recall" "Match found. Opening..."
        imv "$img"
    else
        notify-send "Omni-Recall" "Match found, but image file is missing."
    fi
else
    notify-send "Omni-Recall" "No semantic match found."
fi
