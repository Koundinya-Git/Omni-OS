#!/usr/bin/env bash

QUERY=$(rofi -dmenu -p "Semantic Recall" -theme-str 'window {width: 40%;} listview {lines: 0;}')

if [ -z "$QUERY" ]; then
    exit 0
fi

notify-send "Omni-Recall" "Searching memory for: $QUERY"

RES=$(omni-recall-search "$QUERY")
MATCH=$(echo "$RES" | grep -o '"match": true')

if [ -n "$MATCH" ]; then
    IMG_PATH=$(echo "$RES" | sed -n 's/.*"path": "\([^"]*\)".*/\1/p')
    if [ -f "$IMG_PATH" ]; then
        notify-send "Omni-Recall" "Match found. Opening..."
        imv "$IMG_PATH"
    else
        notify-send "Omni-Recall" "Match found, but image file is missing."
    fi
else
    notify-send "Omni-Recall" "No semantic match found."
fi
