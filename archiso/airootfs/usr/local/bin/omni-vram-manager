#!/usr/bin/env bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
apps="steam gamescope blender kdenlive"
ai_off=0
while true; do
    app_on=0
    for a in $apps; do
        if pgrep -x "$a" >/dev/null; then
            app_on=1
            break
        fi
    done
    if [ $app_on -eq 1 ] && [ $ai_off -eq 0 ]; then
        logger -t omni-vram-manager "Heavy app detected. Stopping Ollama."
        systemctl stop ollama.service || systemctl --user stop ollama.service
        ai_off=1
    elif [ $app_on -eq 0 ] && [ $ai_off -eq 1 ]; then
        logger -t omni-vram-manager "Heavy app exited. Restarting Ollama."
        systemctl start ollama.service || systemctl --user start ollama.service
        ai_off=0
    fi
    sleep 5
done
