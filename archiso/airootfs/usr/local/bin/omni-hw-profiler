#!/usr/bin/env bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
mkdir -p /etc/omni
rmb=$(( $(awk '/MemTotal/ {print $2}' /proc/meminfo) / 1024 ))
pr=0
if [ "$rmb" -gt 64000 ]; then pr=6
elif [ "$rmb" -gt 32000 ]; then pr=4
elif [ "$rmb" -gt 16000 ]; then pr=2
elif [ "$rmb" -gt 8000 ]; then pr=1; fi
cpu=$(nproc)
pc=0
if [ "$cpu" -gt 16 ]; then pc=4
elif [ "$cpu" -gt 8 ]; then pc=2
elif [ "$cpu" -gt 4 ]; then pc=1; fi
ps=0
if lsblk -d -o name | grep -q "^nvme"; then ps=2
elif lsblk -d -o name | grep -q "^sda"; then ps=1; fi
vmb=0
g_t="unknown"
pv=0
pg=0
if command -v nvidia-smi >/dev/null 2>&1; then
    g_t="nvidia"
    vmb=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits | head -n 1 | awk '{print $1}')
    pg=2
elif lspci | grep -i "vga" | grep -iq "amd"; then
    g_t="amd"
    if [ -d "/sys/class/drm/card0/device" ]; then
        v_b=$(cat /sys/class/drm/card0/device/mem_info_vram_total 2>/dev/null || echo 0)
        vmb=$((v_b / 1048576))
    fi
    pg=2
elif lspci | grep -i "vga" | grep -iq "intel"; then
    g_t="intel"
    vmb=$((rmb / 4))
    pg=1
fi
[ -z "$vmb" ] && vmb=0
if [ "$vmb" -gt 24000 ]; then pv=6
elif [ "$vmb" -gt 16000 ]; then pv=4
elif [ "$vmb" -gt 8000 ]; then pv=2
elif [ "$vmb" -gt 4000 ]; then pv=1; fi
tier=$((pr + pc + ps + pv + pg))
[ "$tier" -lt 1 ] && tier=1
[ "$tier" -gt 20 ] && tier=20
echo "OMNI_TIER=$tier" > /etc/omni/hw-tier
cat <<EOF > /etc/omni/hw-profile.json
{
  "total_ram_mb": $rmb,
  "cpu_threads": $cpu,
  "gpu_type": "$g_t",
  "gpu_vram_mb": $vmb,
  "calculated_tier": $tier
}
EOF
logger -t omni-hw-profiler "Hardware profiling complete: Tier $tier (RAM: ${rmb}MB, CPU: $cpu threads, GPU: $g_t, VRAM: ${vmb}MB)"
