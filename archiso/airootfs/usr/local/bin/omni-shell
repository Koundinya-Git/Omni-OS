#!/usr/bin/env python3
import os, sys, subprocess, json, urllib.request
from pathlib import Path
try:
    from prompt_toolkit import PromptSession, prompt
    from prompt_toolkit.styles import Style
    from prompt_toolkit.shortcuts import radiolist_dialog
    h_pt = True
except ImportError:
    h_pt = False
st = Style.from_dict({'prompt': 'ansicyan bold', 'path': 'ansimagenta bold'})
def get_cfg():
    p = Path.home() / '.config' / 'omni' / 'shell.json'
    cfg = {"format_outputs": False}
    if p.exists():
        try:
            with open(p, 'r') as f:
                return {**cfg, **json.load(f)}
        except json.JSONDecodeError: pass
    return cfg
def q_ollama(pmt, sys_p):
    u = "http://localhost:11434/api/generate"
    d = {"model": "llama3.2:8b", "prompt": pmt, "system": sys_p, "stream": False}
    try:
        req = urllib.request.Request(u, data=json.dumps(d).encode('utf-8'), headers={'Content-Type': 'application/json'})
        with urllib.request.urlopen(req) as res:
            return json.loads(res.read().decode('utf-8')).get("response", "").strip()
    except Exception as e:
        print(f"\n[!] Error contacting Ollama: {e}\n")
        return None
def get_ctx():
    c = ""
    try:
        w = subprocess.run(['wl-paste'], capture_output=True, text=True, timeout=1)
        if w.returncode == 0 and w.stdout.strip(): c += f"\nClipboard:\n{w.stdout.strip()[:500]}\n"
    except Exception: pass
    try:
        ls = subprocess.run(['ls', '-la'], capture_output=True, text=True, timeout=1)
        if ls.returncode == 0: c += f"\nDir contents:\n{ls.stdout.strip()[:1000]}\n"
    except Exception: pass
    return c
def run_fix(cmd, cfg):
    while True:
        r = subprocess.run(cmd, shell=True, text=True, capture_output=True)
        if r.returncode == 0:
            if cfg.get("format_outputs", False):
                fmt = q_ollama(r.stdout, "You are an AI formatting terminal output. Summarize clearly.")
                print(fmt if fmt else r.stdout)
            else:
                sys.stdout.write(r.stdout)
            break
        sys.stderr.write(r.stderr)
        print(f"[\033[91mError\033[0m] Code {r.returncode}")
        fx = q_ollama(f"Cmd: {cmd}\nErr:\n{r.stderr}", "You are a sysadmin. Provide exactly 3 separate bash commands to fix, separated by newlines. ONLY commands.")
        if not fx: break
        fl = [f.strip() for f in fx.strip().split('\n') if f.strip()]
        if not fl: break
        if h_pt:
            ch = [(f, f) for f in fl] + [("manual", "Type manual fix..."), ("abort", "Abort")]
            res = radiolist_dialog(title="Failed", text="Select fix:", values=ch).run()
            if res in ("abort", None): break
            if res == "manual":
                cmd = prompt("Enter fix: ")
                if not cmd: break
            else: cmd = res
        else:
            for i, f in enumerate(fl): print(f"{i+1}) {f}")
            print("m) Manual input\nq) Abort")
            c = input("Select option: ").strip()
            if c == 'q': break
            if c == 'm':
                cmd = input("Enter fix: ").strip()
                if not cmd: break
            elif c.isdigit() and 1 <= int(c) <= len(fl):
                cmd = fl[int(c)-1]
            else: break
def main():
    if h_pt: sess = PromptSession()
    else: print("Warning: prompt_toolkit not found.")
    cfg = get_cfg()
    while True:
        try:
            cwd = os.getcwd()
            if h_pt:
                u = sess.prompt([('class:prompt', 'omni-shell '), ('class:path', f'{cwd} '), ('class:prompt', '❯ ')], style=st)
            else:
                u = input(f"omni-shell {cwd} ❯ ")
            u = u.strip()
            if not u: continue
            if u in ("exit", "quit"): break
            if u.startswith("cd "):
                t = os.path.expanduser(u.split(" ", 1)[1].strip())
                try: os.chdir(t)
                except FileNotFoundError: print(f"cd: no such file or directory: {t}")
                continue
            auto = u.startswith("##") and u.endswith("##")
            safe = u.startswith("#") and not auto
            if auto or safe:
                n = u.strip('#').strip()
                ctx = False
                if n.startswith("--context "):
                    ctx = True
                    n = n[10:].strip()
                sp = "Translate natural language to a single valid Bash command. No explanation, no backticks."
                if ctx: sp += get_ctx()
                print("[\033[96mAI\033[0m] Translating...")
                cmd = q_ollama(n, sp)
                if cmd:
                    if safe:
                        print(f"[\033[93mProposed\033[0m] {cmd}")
                        c = input("Execute? [Y/n]: ").strip().lower()
                        if c not in ("", "y", "yes"):
                            print("Aborted.")
                            continue
                    print(f"[\033[95mExecuting\033[0m] {cmd}")
                    run_fix(cmd, cfg)
            else:
                run_fix(u, cfg)
        except KeyboardInterrupt: continue
        except EOFError: break
if __name__ == "__main__":
    main()
