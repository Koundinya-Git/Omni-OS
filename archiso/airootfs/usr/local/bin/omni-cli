#!/usr/bin/env bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
case "$1" in
    status)
        source /etc/omni/hw-tier
        echo "Omni-OS Status:"
        echo "Hardware Tier: $OMNI_TIER"
        echo "Ollama: $(systemctl is-active ollama.service 2>/dev/null || echo 'inactive')"
        echo "Observer: $(systemctl --user is-active omni-observer.service 2>/dev/null || echo 'inactive')"
        ;;
    ask)
        shift
        ollama run llama3.2:1b "$*"
        ;;
    recall)
        shift
        /usr/local/bin/omni-recall-ui "$*"
        ;;
    deep-work)
        /usr/local/bin/deep-work-trigger.sh "$2"
        ;;
    tier)
        cat /etc/omni/hw-tier
        ;;
    *)
        echo "Usage: omni-cli {status|ask 'p'|recall 's'|deep-work on/off|tier}"
        ;;
esac
