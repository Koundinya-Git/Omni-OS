#!/usr/bin/env bash
# omni-cli - CLI interface

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

case "$1" in
    status)
        source /etc/omni/hw-tier
        echo "Omni-OS Status:"
        echo "Hardware Tier: $OMNI_TIER"
        echo "Ollama Status: $(systemctl is-active ollama.service 2>/dev/null || echo 'inactive')"
        echo "Observer Daemon: $(systemctl --user is-active omni-observer.service 2>/dev/null || echo 'inactive')"
        echo "Recall Stats: $(sqlite3 ~/.local/share/omni/recall.db 'select count(*) from recall_frames;' 2>/dev/null || echo 0) frames recorded."
        ;;
    ask)
        shift
        ollama run llama3.2:8b "$*"
        ;;
    recall)
        shift
        sqlite3 ~/.local/share/omni/recall.db "SELECT timestamp, screenshot_path FROM recall_frames WHERE ocr_text LIKE '%$*%';"
        ;;
    deep-work)
        /usr/local/bin/deep-work-trigger.sh "$2"
        ;;
    tier)
        cat /etc/omni/hw-tier
        ;;
    *)
        echo "Usage: omni-cli {status|ask 'prompt'|recall 'search'|deep-work on/off|tier}"
        ;;
esac
