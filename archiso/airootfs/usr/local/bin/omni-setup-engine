#!/usr/bin/env bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
cfg="$HOME/.config/omni"
mkdir -p "$cfg"
[ -f "$cfg/.setup-complete" ] && exit 0
source /etc/omni/hw-tier
mdl="llama3.2:1b"
if [ "$OMNI_TIER" -ge 15 ]; then mdl="llama3.1:70b"
elif [ "$OMNI_TIER" -ge 10 ]; then mdl="llama3.2:8b"
elif [ "$OMNI_TIER" -ge 5 ]; then mdl="llama3.2:3b"; fi
systemctl --user start ollama.service || sudo systemctl start ollama.service || true
ollama serve &>/dev/null &
echo "Pulling $mdl..."
ollama pull "$mdl" >/dev/null 2>&1
sys="Interview the user about: major/profession, preferred browser, media player, social apps, aesthetic preferences, distraction websites, AI persona style. Keep questions brief. Output action tags in JSON-like structure: [INSTALL:pkg1,pkg2], [THEME:name], [BLOCK:site1,site2], [PERSONA:style]."
hist="[{\"role\": \"system\", \"content\": \"$sys\"}]"
clear
echo "Welcome to Omni-OS Setup."
echo "I am your setup assistant. Let's get your system ready."
while true; do
    read -rp "> " inp
    [ -z "$inp" ] && continue
    [[ "$inp" == "exit" || "$inp" == "done" ]] && break
    hist=$(echo "$hist" | jq --arg msg "$inp" '. + [{"role": "user", "content": $msg}]')
    res=$(curl -s -X POST http://localhost:11434/api/chat -d "{\"model\": \"$mdl\", \"messages\": $hist, \"stream\": false}")
    ai_m=$(echo "$res" | jq -r '.message.content')
    hist=$(echo "$hist" | jq --arg msg "$ai_m" '. + [{"role": "assistant", "content": $msg}]')
    echo -e "\nOmni: $(echo "$ai_m" | sed 's/\[.*\]//g')\n"
    if echo "$ai_m" | grep -q "\[INSTALL:"; then
        pkgs=$(echo "$ai_m" | grep -o '\[INSTALL:[^]]*\]' | sed 's/\[INSTALL://;s/\]//' | tr ',' ' ')
        echo "Installing: $pkgs"
        sudo paru -S --noconfirm $pkgs
    fi
    if echo "$ai_m" | grep -q "\[BLOCK:"; then
        echo "$ai_m" | grep -o '\[BLOCK:[^]]*\]' | sed 's/\[BLOCK://;s/\]//' | tr ',' '\n' > "$cfg/blocked-sites.conf"
    fi
    if echo "$ai_m" | grep -q "\[PERSONA:"; then
        echo "$ai_m" | grep -o '\[PERSONA:[^]]*\]' | sed 's/\[PERSONA://;s/\]//' > "$cfg/persona.conf"
    fi
done
touch "$cfg/.setup-complete"
echo "Setup complete. Welcome to Omni-OS."
