#!/opt/omni-venv/bin/python
import os, time, sqlite3, subprocess, json, chromadb
from chromadb.utils import embedding_functions
def get_power_profile():
    try:
        return subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True).stdout.strip()
    except:
        return "balanced"
def get_active_window():
    try:
        data = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True).stdout)
        return data.get("class", ""), data.get("title", "")
    except:
        return "", ""
def main():
    db = os.path.expanduser("~/.local/share/omni/recall.db")
    chr_p = os.path.expanduser("~/.local/share/omni/chroma")
    while not os.path.exists(db):
        time.sleep(10)
    cl = chromadb.PersistentClient(path=chr_p)
    ef = embedding_functions.SentenceTransformerEmbeddingFunction(model_name="all-MiniLM-L6-v2")
    col = cl.get_or_create_collection(name="recall_frames", embedding_function=ef)
    cn = sqlite3.connect(db)
    try:
        cn.execute("ALTER TABLE recall_frames ADD COLUMN embedded INTEGER DEFAULT 0;")
        cn.commit()
    except:
        pass
    l_t = time.time()
    l_win = ""
    while True:
        prof = get_power_profile()
        a_cls, a_tit = get_active_window()
        c_win = f"{a_cls}:{a_tit}"
        if c_win != l_win:
            l_win = c_win
            l_t = time.time()
            afk = False
        else:
            afk = (time.time() - l_t) > 300
        if prof == "power-saver" and not afk:
            time.sleep(30)
            continue
        c = cn.cursor()
        c.execute("SELECT id, timestamp, screenshot_path, ocr_text FROM recall_frames WHERE embedded = 0 AND ocr_text IS NOT NULL LIMIT 5;")
        rows = c.fetchall()
        if not rows:
            time.sleep(10)
            continue
        docs, metas, ids = [], [], []
        for r_id, ts, pth, txt in rows:
            docs.append(f"App: {a_cls}\nTitle: {a_tit}\nTime: {ts}\nContent: {txt}")
            metas.append({"timestamp": ts, "path": pth, "app": a_cls, "title": a_tit})
            ids.append(str(r_id))
        col.add(documents=docs, metadatas=metas, ids=ids)
        for r_id in ids:
            c.execute("UPDATE recall_frames SET embedded = 1 WHERE id = ?", (int(r_id),))
        cn.commit()
        time.sleep(1)
if __name__ == "__main__":
    main()
