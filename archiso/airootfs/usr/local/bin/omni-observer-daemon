#!/usr/bin/env bash
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
db_dir="$HOME/.local/share/omni"
db="$db_dir/telemetry.db"
mkdir -p "$db_dir"
sqlite3 "$db" "CREATE TABLE IF NOT EXISTS telemetry_log(id INTEGER PRIMARY KEY, timestamp INTEGER, app_name TEXT, window_title TEXT, category TEXT, duration_seconds INTEGER);"
prod="kitty code obsidian libreoffice zathura evince anki kicad blender gimp krita octave jupyter"
dist="discord telegram-desktop slack"
l_app=""
l_title=""
t_start=$(date +%s)
while true; do
    win=$(hyprctl activewindow -j 2>/dev/null)
    if [ -n "$win" ] && [ "$win" != "{}" ]; then
        app=$(echo "$win" | jq -r '.class')
        title=$(echo "$win" | jq -r '.title')
        cat="Neutral"
        if echo "$prod" | grep -wq "$app"; then cat="Deep Work"
        elif echo "$dist" | grep -wq "$app"; then cat="Distraction"
        elif [[ "$app" =~ (firefox|chromium) ]] && [[ "$title" =~ (Twitter|X|Reddit|Facebook|Instagram|YouTube) ]]; then cat="Distraction"
        fi
        t_curr=$(date +%s)
        if [ "$app" != "$l_app" ] || [ "$title" != "$l_title" ]; then
            if [ -n "$l_app" ]; then
                dur=$((t_curr - t_start))
                if [ $dur -gt 0 ]; then
                    sqlite3 "$db" "INSERT INTO telemetry_log (timestamp, app_name, window_title, category, duration_seconds) VALUES ($t_start, '$(echo "$l_app" | sed "s/'/''/g")', '$(echo "$l_title" | sed "s/'/''/g")', '$cat', $dur);"
                fi
            fi
            l_app="$app"
            l_title="$title"
            t_start=$t_curr
        fi
    fi
    sleep 10
done
