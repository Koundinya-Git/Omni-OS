QWidget {
    background-color: #050505;
    color: #ffffff;
    font-family: "JetBrainsMono Nerd Font", "monospace";
}

#mainApp, #stepList {
    background-color: #050505;
}

QFrame#mainApp {
    background-color: #0a0a0a;
    border-radius: 8px;
    border: 1px solid #0044ff;
}

QPushButton {
    background-color: #0a0a0a;
    color: #ffffff;
    border: 1px solid #0044ff;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #0044ff;
    border: 1px solid #00e5ff;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #00e5ff;
    color: #050505;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: #050505;
    color: #ffffff;
    border: 1px solid #0044ff;
    border-radius: 8px;
    padding: 4px 8px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #00e5ff;
}

QProgressBar {
    background-color: #0a0a0a;
    border: 1px solid #0044ff;
    border-radius: 8px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #00e5ff;
    border-radius: 6px;
}

QListView {
    background-color: #0a0a0a;
    border: 1px solid #0044ff;
    border-radius: 8px;
}

QListView::item:selected {
    background-color: #00e5ff;
    color: #050505;
}

QLabel {
    color: #ffffff;
}

QGroupBox {
    border: 1px solid #0044ff;
    border-radius: 8px;
    margin-top: 2ex;
    color: #00e5ff;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
}

QCheckBox {
    color: #ffffff;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #0044ff;
    background-color: #050505;
}

QCheckBox::indicator:checked {
    background-color: #00e5ff;
    border: 1px solid #00e5ff;
}
